# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Ma'lumotlar bazasi (faqat PostgreSQL) ───────────────────────────────────
# SQLite QO'LLAB-QUVVATLANMAYDI — dev/test/prod hammasi PostgreSQL.
# O'rnatilmasa lokal Docker Postgres'ga (127.0.0.1:5432) default ulanadi.
# Docker Compose: DATABASE_URL avtomatik o'rnatiladi (docker-compose.yml).
# Tashqi server uchun:
DATABASE_URL=postgres://onlinetest:KUCHLI_PAROL@localhost:5432/onlinetest
# DB_CONN_MAX_AGE=60
# DATABASE_SSL_REQUIRE=1  (cloud PostgreSQL uchun)

# ─── Redis ───────────────────────────────────────────────────────────────────
# VAC nonce replay cache (ko'p worker Gunicorn uchun majburiy).
# Docker Compose: REDIS_URL avtomatik o'rnatiladi.
REDIS_URL=redis://localhost:6379/0

# ─── Celery (background AI tasklari) ─────────────────────────────────────────
# proctor-frame AI tahlilini web jarayonidan tashqari worker'ga chiqaradi.
# Broker bo'lmasa (CELERY_BROKER_URL ham, REDIS_URL ham yo'q) task'lar SYNC ishlaydi (eager).
# Odatda REDIS_URL yetarli — alohida broker kerak bo'lsa:
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Worker ishga tushirish (lokalda): celery -A exam_platform worker -l info --concurrency=2
# CELERY_WORKER_CONCURRENCY=2
# CELERY_TASK_TIME_LIMIT=120

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
# JWT amal qilish muddati (soat, 1–168)
# JWT_EXPIRE_HOURS=24

# ─── HTTPS / Proxy ───────────────────────────────────────────────────────────
# DJANGO_SECURE_SSL=1
# SECURE_PROXY_SSL_HEADER=X-Forwarded-Proto:https
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# TRUST_X_FORWARDED_HOST=1

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Ijtimoiy havola / sertifikat tekshiruvi (frontend domeni)
PUBLIC_APP_URL=

# ─── OpenAI / Gemini ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_MODEL_FALLBACKS=gpt-4o-mini
# Eski nomlar (ixtiyoriy, OPENAI_* ustun)
# GEMINI_API_KEY=

# Faqat dev/lab: yuz tekshiruvini o'tkazib yuborish (prod da qo'ymang)
# ALLOW_IDENTITY_VERIFY_BYPASS=1

# ─── iMentor tashqi test bazasi ──────────────────────────────────────────────
# Admin imtihon yaratish va talaba start da iMentor API dan test olinadi.
# IMENTOR_API_KEY=your-x-api-key
# IMENTOR_API_BASE_URL=https://imentor.devflix.uz/api

# ─── Loglar ──────────────────────────────────────────────────────────────────
# LOG_JSON=1          (Loki / journald uchun JSON formatda)
# APP_BUILD_REF=v1.2.3

# ─── Bootstrap (bir martalik) ────────────────────────────────────────────────
# ADMIN_BOOTSTRAP_ID=fjstiadmin
# ADMIN_BOOTSTRAP_PASSWORD=kuchli-parol-min-12
# DEMO_SEED_PASSWORD=

# ─── Socket.IO realtime (Node server) ────────────────────────────────────────
# SOCKET_IO_CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# REALTIME_PORT=3001
# JWT_SECRET ni yuqoridagi bilan bir xil qo'ying
